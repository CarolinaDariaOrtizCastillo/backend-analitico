{
  "swagger": "2.0",
  "info": {
    "title": "Backend Analítico API",
    "description": "Servicios analíticos empresariales desarrollados con Flask, MongoDB y SQL Server mediante arquitectura por capas.",
    "version": "1.0"
  },
  "host": "127.0.0.1:5000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {


    "/": {
      "get": {
        "summary": "Verificar estado del Backend",
        "description": "Permite validar que la API está funcionando correctamente.",
        "responses": {
          "200": {
            "description": "Backend operativo"
          }
        }
      }
    },




    "/analytics/sales-total": {
      "get": {
        "summary": "Obtener ventas totales",
        "description": "Calcula el monto total vendido utilizando información empresarial almacenada en las fuentes de datos configuradas.",
        "tags": [
          "Indicadores Analíticos"
        ],
        "responses": {


          "200": {
            "description": "Cálculo realizado correctamente",
            "schema": {
              "type": "object",
              "properties": {


                "indicator_name": {
                  "type": "string",
                  "example": "Total Sales"
                },


                "total_sales": {
                  "type": "number",
                  "example": 2855530
                },


                "currency": {
                  "type": "string",
                  "example": "PEN"
                }


              }
            }
          },




          "500": {
            "description": "Error interno del servidor"
          }


        }
      }
    },


    "/analytics/sales-by-region": {
      "get": {
        "summary": "Obtener ventas por región",
        "description": "Devuelve la suma de ventas por cada región usando SQL Server.",
        "tags": [
          "Indicadores Analíticos"
        ],
        "responses": {
          "200": {
            "description": "Cálculo realizado correctamente",
            "schema": {
              "type": "object",
              "properties": {
                "indicator": {
                  "type": "string",
                  "example": "sales_by_region"
                },
                "title": {
                  "type": "string",
                  "example": "Ventas por Región"
                },
                "chart_type": {
                  "type": "string",
                  "example": "bar"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "region": {
                        "type": "string",
                        "example": "Lima"
                      },
                      "sales": {
                        "type": "number",
                        "example": 2050.5
                      }
                    }
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "example": "SQL Server"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/analytics/top-product": {
      "get": {
        "summary": "Obtener el producto más vendido del mes",
        "description": "Integra la cantidad vendida desde SQL Server con los datos maestros del producto en MongoDB.",
        "tags": [
          "Indicadores Analíticos"
        ],
        "responses": {
          "200": {
            "description": "Indicador calculado correctamente",
            "schema": {
              "type": "object",
              "properties": {
                "indicator": {
                  "type": "string",
                  "example": "top_product_month"
                },
                "title": {
                  "type": "string",
                  "example": "Producto más vendido del mes"
                },
                "chart_type": {
                  "type": "string",
                  "example": "card"
                },
                "data": {
                  "type": "object",
                  "properties": {
                    "product_id": {
                      "type": "string",
                      "example": "P001"
                    },
                    "product": {
                      "type": "string",
                      "example": "Producto de ejemplo"
                    },
                    "category": {
                      "type": "string",
                      "example": "Categoría de ejemplo"
                    },
                    "quantity": {
                      "type": "number",
                      "example": 150
                    }
                  }
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "SQL Server",
                    "MongoDB"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No se encontró información del producto más vendido"
          },
          "503": {
            "description": "No se pudo conectar con MongoDB Atlas"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    }


  }
}
